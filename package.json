{
  "name": "reasp-cli",
  "version": "1.0.1",
  "description": "REASP · Global installer, SDD orchestrator, and agent backup manager",
  "type": "module",
  "bin": {
    "reasp": "./installer/index.js"
  },
  "scripts": {
    "prepare": "node -e \"try{require('fs').chmodSync('./scripts/reasp',0o755)}catch(e){}\"",
    "postinstall": "node ./installer/scripts/postinstall.js",
    "test": "node scripts/check-syntax.js"
  },
  "preferGlobal": true,
  "files": [
    "installer/",
    "scripts/",
    ".opencode/",
    ".MeridianUI/",
    "README.md",
    "LICENSE.md",
    "REASP-Guide.html",
    "GIT-GITHUB-GUIDE.html"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["reasp", "rass", "refi", "ai-agent", "cli", "backup"],
  "author": "Kevin Keor",
  "license": "SEE LICENSE IN LICENSE.md"
}
